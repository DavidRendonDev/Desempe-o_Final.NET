@{
    ViewData["Title"] = "Login";
}

<h2>Admin Login</h2>

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}

<form method="post">
    <div>
        <label>Email</label>
        <input name="email" />
    </div>

    <div>
        <label>Password</label>
        <input name="password" type="password" />
    </div>

    <button type="submit">Login</button>
</form>