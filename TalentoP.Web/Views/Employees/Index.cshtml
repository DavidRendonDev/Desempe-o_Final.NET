@model List<Domain.Entities.Employee>

@{
    ViewData["Title"] = "Employees";
}

<h2>Employees</h2>

<p>
    <a asp-action="Create">Create Employee</a>
</p>

<table class="table">
    <thead>
    <tr>
        <th>Document</th>
        <th>Full Name</th>
        <th>Email</th>
        <th>Status</th>
        <th>Department</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.DocumentNumber</td>
            <td>@e.FirstName @e.LastName</td>
            <td>@e.Email</td>
            <td>@e.EmploymentStatus</td>
            <td>@(e.Department?.Name ?? "-")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@e.Id">Edit</a> |
                <a asp-action="ResumePdf" asp-route-id="@e.Id">PDF</a> |

                <a asp-action="Delete" asp-route-id="@e.Id">Delete</a>

            </td>
        </tr>
    }
    </tbody>
</table>