@model TalentoP.Web.ViewModels.EmployeeFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create Employee";
    var departments = ViewBag.Departments as List<SelectListItem> ?? new();
}

<h2>Create Employee</h2>

<form method="post">
    <div>
        <label>Document Number</label>
        <input asp-for="DocumentNumber" />
        <span asp-validation-for="DocumentNumber"></span>
    </div>

    <div>
        <label>First Name</label>
        <input asp-for="FirstName" />
        <span asp-validation-for="FirstName"></span>
    </div>

    <div>
        <label>Last Name</label>
        <input asp-for="LastName" />
        <span asp-validation-for="LastName"></span>
    </div>

    <div>
        <label>Email</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label>Phone</label>
        <input asp-for="Phone" />
    </div>

    <div>
        <label>Job Title</label>
        <input asp-for="JobTitle" />
    </div>

    <div>
        <label>Salary</label>
        <input asp-for="Salary" />
    </div>

    <div>
        <label>Hire Date</label>
        <input asp-for="HireDate" type="date" />
        <span asp-validation-for="HireDate"></span>
    </div>

    <div>
        <label>Status</label>
        <select asp-for="EmploymentStatus">
            <option>Active</option>
            <option>Inactive</option>
            <option>Vacation</option>
        </select>
        <span asp-validation-for="EmploymentStatus"></span>
    </div>

    <div>
        <label>Department</label>
        <select asp-for="DepartmentId" asp-items="departments"></select>
        <span asp-validation-for="DepartmentId"></span>
    </div>

    <div>
        <label>Education Level</label>
        <input asp-for="EducationLevel" />
    </div>

    <div>
        <label>Professional Profile</label>
        <textarea asp-for="ProfessionalProfile"></textarea>
    </div>

    <button type="submit">Save</button>
    <a asp-action="Index">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
